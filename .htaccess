# ============================================================================
# Surviving the Feds — Apache config (Hostinger)
# ============================================================================

# Default document — PHP first, HTML fallback
DirectoryIndex index.php index.html

# --- Security: block direct access to PHP include partials ------------------
RedirectMatch 404 /\.git(/|$)
<FilesMatch "^_">
  Require all denied
</FilesMatch>

# --- URL rewrites ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS + non-www (canonical host — one URL per page)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://survivingthefeds.com%{REQUEST_URI} [R=301,L]

  # Redirect .html → .php (301 permanent for SEO)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)\.html$ /$1.php [R=301,L]

  # Bare URL (no extension) → .php if the file exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+)$ /$1.php [L]
</IfModule>

# --- Caching -----------------------------------------------------------------
<IfModule mod_headers.c>
  # PHP/HTML pages: always revalidate
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  # Static assets: long-term cache — filemtime ?v= query busts on change
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Correct MIME types ------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

# --- Compression -------------------------------------------------------------
# NOTE: woff2 is already Brotli-compressed internally — never re-compress fonts.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>
